# ── 필수 ──────────────────────────────────────────────────────────────
# 세션 쿠키 서명용 비밀키 (32자 이상 아무 문자열). 예: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# 사이트 공개 주소 (포스터 QR, 절대 URL 생성에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 데이터베이스 ───────────────────────────────────────────────────────
# 비워두면 로컬 파일 DB(PGlite, ./.data/pg)로 동작합니다 (개발용).
# 운영(Vercel)에서는 Supabase 등 Postgres 접속 문자열을 넣으세요.
# 예: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Vercel 의 Neon 연동을 쓰면 자동으로 들어옵니다(sslmode=require 포함, 인증서 검증됨).
DATABASE_URL=

# ── 영수증 인식 (Claude) ───────────────────────────────────────────────
# 비워두면 인식이 되지 않고 모든 영수증이 "관리자 확인 대기"로 들어갑니다.
ANTHROPIC_API_KEY=
# 기본 claude-opus-5. 비용을 낮추려면 claude-sonnet-5.
RECEIPT_MODEL=claude-opus-5

# 운영 DB 서버 인증서를 검증하려면 Supabase 의 "SSL certificate"(PEM) 내용을 넣습니다. 비우면 암호화만 하고 검증은 건너뜁니다.
DATABASE_CA=

# ── 관리자 초기 계정 (최초 1회 자동 생성) ──────────────────────────────
# 총괄 관리자(모든 매장). 나중에 관리자 화면에서 매장별 직원 계정을 추가할 수 있습니다.
# 운영(NODE_ENV=production)에서는 10자 이상의 새 비밀번호가 아니면 계정을 만들지 않고 /admin/login 에 그 이유를 띄웁니다.
# (손님 화면은 그대로 열립니다.) admin1234·password 같은 흔한 값은 쓸 수 없습니다.
ADMIN_INITIAL_ID=owner
ADMIN_INITIAL_PASSWORD=Seomyeon2026owner

# ── 보관 정리 크론 ─────────────────────────────────────────────────────
# /api/cron/purge 를 부를 때 쓰는 비밀값 (Vercel Cron 이 Authorization: Bearer 로 보냅니다). 예: openssl rand -hex 24
CRON_SECRET=

# ── 첫 화면 성인 확인 판 ───────────────────────────────────────────
# 술을 다루는 사이트라 첫 방문에 한 번 묻습니다. 국내 주류 사이트가 쓰는 그 판입니다
# (오비맥주는 예·아니요 버튼 하나만 씁니다). 계약도 비용도 없고 개인정보도 받지 않습니다.
#   year   (기본) 태어난 해 네 자리를 받아 연 나이로 판정합니다. 한 번 통과하면 180일간 안 묻습니다.
#   yesno  오비맥주식 예·아니요 버튼. 가장 빠르지만 아무나 누를 수 있습니다.
#   off    판을 아예 띄우지 않습니다.
# 이건 손님이 스스로 말하는 나이라 "확인"이 아니라 "고지"입니다. 진짜 확인은 아래 휴대폰 본인확인입니다.
ADULT_GATE=

# ── 휴대폰 본인확인 (성인 확인 + 번호 소유 확인) ──────────────────────
# 비워 두면 이 기능이 꺼지고, 로그인은 지금처럼 번호 입력만으로 됩니다.
# 세 값이 다 채워지면 로그인이 "통신사 본인확인" 한 번으로 바뀌고,
# 쿠폰함·쿠폰 상세·사용 매장 고르기가 성인 확인을 통과한 사람에게만 열립니다.
#
# 어디와 계약할까 — 통신사를 고르고 생년월일을 넣는 그 창이 뜨는 곳은 다날과 NHN KCP 둘뿐입니다.
#   · 다날       권장. 그 창이 그대로 뜨고, 인증창 단계에서 나이로 한 번 걸러 줍니다.
#   · NHN KCP    같은 창이 뜹니다. 단가가 공개돼 있지 않아 포트원(cs@portone.io)에 물어봐야 합니다.
#   · KG이니시스  쓰지 마세요. 통신사 창이 아니라 네이버·카카오·토스 같은 민간인증서를 고르는 창이고,
#                술을 다루는 사이트는 인증기관 쪽에서 입점을 막습니다. 중복 확인용 DI 도 주지 않습니다.
#
# 발급 순서 (다날 기준)
#   1. admin.portone.io 가입 → [전자결제 신청]에서 사업자 정보 등록. 사업자등록증이 필요하고 개인사업자도 됩니다.
#      (개인사업자는 사업자등록증의 대표자와 정산 통장 예금주가 같아야 합니다.)
#   2. 다날 휴대폰 본인확인 신청. 서류 검수에 2~5일, 계약 뒤 서비스 개시까지 7~10일 걸립니다.
#      등록비 110,000원 + 월정액(5만원 1,200건 / 10만원 2,400건 / 20만원 4,800건, 초과 건당 50원, VAT 별도).
#
#      ※ 신청서에 "전화번호 제공"을 꼭 넣으세요. 기본 계약은 이름·성별·생년월일만 주고 번호를 주지 않습니다.
#        번호를 안 받으면 손님이 번호를 손으로 적게 되고, 그러면 이 기능을 붙인 이유였던
#        "남의 번호로 남의 쿠폰함 보기"가 절반만 막힙니다(한 사람이 번호 하나만 쓰도록만 막힙니다).
#        전화번호·통신사·내외국인은 민감정보라 계약 뒤 따로 신청해야 하고 처리에 최대 1주가 더 걸립니다.
#
#   3. 포트원 콘솔 > [연동 관리] > [채널 관리]에서 채널을 추가하되, 채널 속성을 '결제'가 아니라
#      '본인인증'으로 고르고 다날이 준 CPID·CPPWD 를 넣습니다.
#   4. [연동 정보] 오른쪽 위의 Store ID, [채널 관리]의 채널 키, [식별코드·API Keys] > V2 API 탭에서
#      발급한 API Secret 을 아래에 붙여넣습니다. API Secret 은 발급 화면을 벗어나면 다시 볼 수 없습니다.
#
# 다날은 통신사 정책상 테스트 환경이 없습니다 — 실제 인증창은 계약이 끝나야 처음 떠 봅니다.
# 그때까지는 PORTONE_IDENTITY_MOCK=1 로 내 컴퓨터에서 흐름만 확인하세요.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 계약한 곳: danal | kcp | inicis
# 비워 두면 인증창 제목이 "포트원"으로 뜨고, 다날의 나이 사전 차단도 걸리지 않습니다.
PORTONE_IDENTITY_PG=
# 다날 인증창에 표시될 서비스 이름. 비우면 "알콜부시기"
PORTONE_SERVICE_NAME=

# 내 컴퓨터에서 흐름만 볼 때 1. NODE_ENV=production 이면 무시되므로 운영·미리보기에서는 절대 켜지지 않습니다.
PORTONE_IDENTITY_MOCK=
