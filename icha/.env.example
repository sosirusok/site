# ── 필수 ──────────────────────────────────────────────────────────────
# 세션 쿠키 서명용 비밀키 (32자 이상 아무 문자열). 예: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# 사이트 공개 주소 (포스터 QR, 절대 URL 생성에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 데이터베이스 ───────────────────────────────────────────────────────
# 비워두면 로컬 파일 DB(PGlite, ./.data/pg)로 동작합니다 (개발용).
# 운영(Vercel)에서는 Supabase 등 Postgres 접속 문자열을 넣으세요.
# 예: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Vercel 의 Neon 연동을 쓰면 자동으로 들어옵니다(sslmode=require 포함, 인증서 검증됨).
DATABASE_URL=

# ── 영수증 인식 (Claude) ───────────────────────────────────────────────
# 비워두면 인식이 되지 않고 모든 영수증이 "관리자 확인 대기"로 들어갑니다.
ANTHROPIC_API_KEY=
# 기본 claude-opus-5. 비용을 낮추려면 claude-sonnet-5.
RECEIPT_MODEL=claude-opus-5

# 운영 DB 서버 인증서를 검증하려면 Supabase 의 "SSL certificate"(PEM) 내용을 넣습니다. 비우면 암호화만 하고 검증은 건너뜁니다.
DATABASE_CA=

# ── 관리자 초기 계정 (최초 1회 자동 생성) ──────────────────────────────
# 총괄 관리자(모든 매장). 나중에 관리자 화면에서 매장별 직원 계정을 추가할 수 있습니다.
# 운영(NODE_ENV=production)에서는 10자 이상의 새 비밀번호가 아니면 계정을 만들지 않고 /admin/login 에 그 이유를 띄웁니다.
# (손님 화면은 그대로 열립니다.) admin1234·password 같은 흔한 값은 쓸 수 없습니다.
ADMIN_INITIAL_ID=owner
ADMIN_INITIAL_PASSWORD=Seomyeon2026owner

# ── 보관 정리 크론 ─────────────────────────────────────────────────────
# /api/cron/purge 를 부를 때 쓰는 비밀값 (Vercel Cron 이 Authorization: Bearer 로 보냅니다). 예: openssl rand -hex 24
CRON_SECRET=

# ── 휴대폰 본인확인 (성인인증) ─────────────────────────────────────────
# 비워 두면 이 기능이 꺼지고, 로그인은 지금처럼 번호 입력만으로 됩니다.
# 세 값이 다 채워지면 로그인 화면이 "통신사 본인확인" 한 번으로 바뀌고,
# 쿠폰함·쿠폰 상세·사용 매장 고르기가 성인 확인을 통과한 사람에게만 열립니다.
#
# 발급 순서
#   1. admin.portone.io 가입 (사업자등록증 필요)
#   2. 결제 연동 > 채널 관리에서 본인인증 채널 추가 → 다날 / NHN KCP / KG이니시스 중 택1 계약
#      (계약·심사는 PG사가 합니다. 이 사이트 주소를 심사에 냅니다.)
#   3. 연동 정보 화면 오른쪽 위의 Store ID, 채널 관리 탭의 채널 키, API Secret 을 아래에 붙여넣기
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 계약한 곳: danal | kcp | inicis  (다날이면 인증창 자체가 만 19세 미만을 막습니다)
PORTONE_IDENTITY_PG=
# 다날 인증창에 표시될 서비스 이름. 비우면 "알콜부시기"
PORTONE_SERVICE_NAME=

# 내 컴퓨터에서 흐름만 볼 때 1. NODE_ENV=production 이면 무시되므로 운영·미리보기에서는 절대 켜지지 않습니다.
PORTONE_IDENTITY_MOCK=
