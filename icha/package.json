    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
